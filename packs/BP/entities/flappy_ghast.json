        "priority": 4,
        "can_tempt_vertically": true,
        "items": ["minecraft:snowball"],
        "within_radius": 16,
        "stop_distance": 6
      },
      "minecraft:behavior.float_wander": {
        "priority": 7,
        "must_reach": true,
        "random_reselect": true,
        "navigate_around_surface": true,
        "surface_xz_dist": 12,
        "surface_y_dist": 8,
        "float_duration": [2.0, 7.0]
      },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0" }
