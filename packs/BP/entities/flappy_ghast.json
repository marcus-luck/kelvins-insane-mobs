{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "kim:flappy_ghast",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true
    },
    "components": {
      "minecraft:type_family": { "family": ["flappy_ghast", "mob"] },
      "minecraft:health": { "value": 30, "max": 30 },
      "minecraft:collision_box": { "width": 3.0, "height": 3.0 },
      "minecraft:physics": { "has_gravity": false },
      "minecraft:can_fly": {},
      "minecraft:jump.static": {},
      "minecraft:is_tamed": {},
      "minecraft:nameable": {},
      "minecraft:leashable": {},
      "minecraft:fire_immune": true,
      "minecraft:breathable": { "total_supply": 5, "suffocate_time": 0, "breathes_air": true, "breathes_water": false },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fall", "deals_damage": "no" },
          { "cause": "projectile", "deals_damage": "no" },
          { "cause": "entity_explosion", "deals_damage": "no" },
          { "cause": "block_explosion", "deals_damage": "no" },
          { "cause": "fire", "deals_damage": "no" },
          { "cause": "fire_tick", "deals_damage": "no" }
        ]
      },
      "minecraft:healable": { "items": [{ "item": "minecraft:snowball", "heal_amount": 4 }] },
      "minecraft:movement": { "value": 0.03 },
      "minecraft:flying_speed": { "value": 0.03 },
      "minecraft:navigation.float": { "can_path_over_water": true, "avoid_damage_blocks": true, "avoid_water": true },
      "minecraft:pushable_by_block": {},
      "minecraft:body_rotation_always_follows_head": {},
      "minecraft:rideable": {
        "seat_count": 2,
        "family_types": ["player"],
        "dismount_mode": "on_top_center",
        "interact_text": "action.interact.ride.horse",
        "seats": [
          { "min_rider_count": 0, "max_rider_count": 2, "position": [0.0, 2.85, 0.6], "third_person_camera_radius": 7.0, "camera_relax_distance_smoothing": 6.0 },
          { "min_rider_count": 1, "max_rider_count": 2, "position": [0.0, 2.85, -0.8], "third_person_camera_radius": 7.0, "camera_relax_distance_smoothing": 6.0 }
        ]
      },
      "minecraft:free_camera_controlled": { "strafe_speed_modifier": 1.0, "backwards_movement_modifier": 0.5 },
