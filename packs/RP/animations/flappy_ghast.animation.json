{
  "format_version": "1.8.0",
  "animations": {
    "animation.kim.flappy_ghast.flap": {
      "loop": true,
      "bones": {
        "wing_left": { "rotation": [0, 0, "math.sin(v.flap) * 40 + 5"] },
        "wing_left_tip": { "rotation": [0, 0, "math.sin(v.flap - 50) * 30"] },
        "wing_right": { "rotation": [0, 0, "-math.sin(v.flap) * 40 - 5"] },
        "wing_right_tip": { "rotation": [0, 0, "-math.sin(v.flap - 50) * 30"] },
        "body": { "rotation": ["math.clamp(-query.vertical_speed * 2.5, -12, 12)", 0, 0] }
      }
    },
    "animation.kim.flappy_ghast.float": {
      "loop": true,
      "bones": {
        "root": { "position": [0, "math.sin(query.life_time * 90) * 1.5", 0] },
        "tentacle_0": { "rotation": ["math.sin(query.life_time * 360 + 0) * 11 + 15", 0, 0] },
        "tentacle_1": { "rotation": ["math.sin(query.life_time * 360 + 60) * 11 + 15", 0, 0] },
        "tentacle_2": { "rotation": ["math.sin(query.life_time * 360 + 120) * 11 + 15", 0, 0] },
        "tentacle_3": { "rotation": ["math.sin(query.life_time * 360 + 180) * 11 + 15", 0, 0] },
        "tentacle_4": { "rotation": ["math.sin(query.life_time * 360 + 240) * 11 + 15", 0, 0] },
        "tentacle_5": { "rotation": ["math.sin(query.life_time * 360 + 300) * 11 + 15", 0, 0] }
      }
    }
  }
}
